# GitHub (이슈/PR 접근용)
# https://github.com/settings/tokens 에서 Personal Access Token 발급
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=owner/repository-name

# LLM API (CrewAI가 사용)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key  # OpenAI 사용 시

# ─── 선택: Vercel (배포 트리거 등) ───
# https://vercel.com/account/tokens
# VERCEL_TOKEN=your_vercel_token

# ─── 선택: Discord (알림·메시지 전송) ───
# 봇 토큰: https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=your_discord_bot_token
# 채널 ID: 상한 초과·이슈 처리 실패(LLM 오류 등) 시 알림 전송
# DISCORD_CHANNEL_ID=your_channel_id

# ─── 선택: LLM 사용량 상한 (대시보드에서 확인·리셋) ───
# 상한 설정 시 초과하면 새 LLM 호출 차단 + Discord 알림 1회 전송 (DISCORD_* 설정 필요)
# USAGE_LIMIT_TOKENS=500000
# USAGE_LIMIT_CALLS=100
# 비용 추정용 모델 이름 (gpt-4o / claude 등, 미설정 시 gpt-4o 기준)
# LLM_COST_MODEL=gpt-4o

# ─── Phase 5: GitHub Webhook (PR 머지 감지) ───
# GitHub 저장소 → Settings → Webhooks에서 등록
# Payload URL: https://your-server/webhooks/github
# Content type: application/json, Secret: 아래 값과 동일하게 입력
# 이벤트: Pull requests
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ─── Phase 4: 멀티 LLM 설정 (역할별 환경변수로 모델 지정) ───
# 기본값: openai/gpt-4o (AGENT_LLM_DEFAULT 또는 하드코딩 폴백)
# Claude로 전환 시: ANTHROPIC_API_KEY 추가 후 아래 값만 변경
#
# AGENT_LLM_DEFAULT=openai/gpt-4o
# AGENT_LLM_VICE=openai/gpt-4o          # 바이스 — PM, 요구사항 분석
# AGENT_LLM_AZURE=openai/gpt-4o         # 아주르 — UI 디자인 + 퍼블리싱
# AGENT_LLM_FLEUR=openai/gpt-4o         # 플뢰르 — 코드 구현
# AGENT_LLM_ELSI=openai/gpt-4o          # 엘시 — Devil's Advocate
# AGENT_LLM_BETHEL=openai/gpt-4o-mini   # 베델 — QA (빠른 검토용)
#
# Claude 전환 예시:
# ANTHROPIC_API_KEY=your_anthropic_api_key
# AGENT_LLM_FLEUR=anthropic/claude-opus-4-6
# AGENT_LLM_VICE=anthropic/claude-sonnet-4-6
#
# CrewAI 내 워커 타임아웃 (초, 기본 600)
# CREW_TIMEOUT_SECONDS=600

# ─── Phase 2: Worker Architecture 백엔드 설정 ───
# DB 백엔드: sqlite | postgres | hybrid
# ARCHITECTURE_DB_BACKEND=sqlite
# ARCHITECTURE_DB_PATH=.agent_architecture.db
# ARCHITECTURE_POSTGRES_DSN=postgresql://user:pass@localhost:5432/agent_system
# Postgres 실패 시 sqlite로 fallback 허용 (postgres 모드에서도 사용 가능)
# ARCHITECTURE_DB_FALLBACK_SQLITE=1
#
# Queue 백엔드: local | redis
# ARCHITECTURE_QUEUE_BACKEND=local
# ARCHITECTURE_REDIS_URL=redis://127.0.0.1:6379/0
# WORKER_POLL_INTERVAL_SECONDS=0.5
# WORKER_DEQUEUE_TIMEOUT_SECONDS=1
#
# CORS (쉼표 구분)
# ARCHITECTURE_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# 선택: write API 보호 키 (설정 시 POST/PATCH + WebSocket 인증 필요)
# ARCHITECTURE_API_KEY=change-me
